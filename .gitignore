# ==============================================================================
# HumanMol AI - Industry Standard .gitignore
# Best coding practices for Full-Stack AI/ML, Python, Next.js, and Scientific Computing
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sensitive Environment & Credentials (NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret
credentials.json
token.json
auth_token.json
id_rsa
id_rsa.pub
id_ed25519

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.next/
*/.next/
out/
build/
dist/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.turbo/
.eslintcache
.stylelintcache
.prettiercache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caching & Build Distributions
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
*/.egg-info/
*.egg
.eggs/
develop-eggs/
downloads/
eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 4. Virtual Environments & Conda
# ------------------------------------------------------------------------------
.venv/
*/.venv/
venv/
*/venv/
ENV/
env/
.conda/
*/.conda/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 5. Local Databases & Runtime State (Never commit mutating SQLite files)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/*.db
database/*.sqlite*
database/humanmol.db
*.db.bak

# ------------------------------------------------------------------------------
# 6. Scientific Computing, Docking & Experiment Runtime Outputs
# ------------------------------------------------------------------------------
experiments/
*/experiments/
scientific-engine/docking/experiments/
scientific-engine/docking/runs/
scientific-engine/docking/tmp/
logs/
*.log
*.tmp
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 7. Testing, Code Coverage & Static Analysis
# ------------------------------------------------------------------------------
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
nosetests.xml
*.cover
*.py,cover
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 8. Jupyter Notebooks & Data Science Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 9. Large Binary Archives & Weights (>100MB exceeds GitHub limits)
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
saved_model.zip
scientific-engine/cell-response/XPert/saved_model/saved_model.zip

# ------------------------------------------------------------------------------
# 10. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r\r
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
Desktop.ini
*.stackdump

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 11. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 12. Local Subproject Junctions & Cloned External Repositories
# ------------------------------------------------------------------------------
scientific_engine
XPert
REINVENT4/build/
REINVENT4/dist/
REINVENT4/*.egg-info/
